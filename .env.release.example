# Release assets replace this with the exact multiarchitecture image digest.
PAPERLENS_IMAGE=ghcr.io/guigui42/paperlens:0.1.2
PAPERLENS_ORIGIN=http://127.0.0.1:8080
PAPERLENS_BIND_IP=127.0.0.1
PAPERLENS_PORT=8080
PAPERLESS_URL=https://paperless.example.com
COPILOT_MODEL=gpt-6-luna
PAPERLENS_AI=true
PAPERLENS_EXCLUDED_TAGS=Export financier
# Empty disables uploads. Confirm parser support before enabling formats.
PAPERLENS_UPLOAD_TYPES=

# Files on the Docker/Komodo execution host, not on the Komodo web server.
# Keep them outside the Git repository, owned by UID/GID 10001 with mode 0600.
PAPERLESS_TOKEN_PATH=/etc/komodo/secrets/paperlens/paperless_token
COPILOT_TOKEN_PATH=/etc/komodo/secrets/paperlens/copilot_token
