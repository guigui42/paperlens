# Copy to .env for Compose. Never commit your real values.
PAPERLENS_ORIGIN=http://localhost:8080
PAPERLESS_URL=http://paperless.example:8000
PAPERLENS_AI=true
COPILOT_MODEL=gpt-5.4
# Opt in only after confirming these parsers on YOUR instance.
PAPERLENS_UPLOAD_TYPES=pdf,png,jpg,jpeg

# Local Go binary configuration (export these, not just a .env file):
# PAPERLENS_LAN_ONLY=true
# PAPERLESS_TOKEN_FILE=/absolute/path/to/paperless_token
# COPILOT_GITHUB_TOKEN_FILE=/absolute/path/to/copilot_token
# COPILOT_CLI_PATH=/absolute/path/to/copilot
# PAPERLENS_STATE_DIR=.state
# PAPERLENS_RUNTIME_DIR=/dedicated/private/tmp/paperlens
# PAPERLENS_MAX_SEARCHES=6
# PAPERLENS_MAX_CANDIDATES=100
# PAPERLENS_MAX_EXCERPTS=12
# PAPERLENS_EXCERPT_CHARS=8000
# PAPERLENS_CONCURRENCY=2
# PAPERLENS_QUEUE=4
# PAPERLENS_SEARCH_TIMEOUT=90s
# PAPERLENS_MAX_UPLOAD_MB=20
